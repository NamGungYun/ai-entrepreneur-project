{
  "$description": "SAHMYOOK-DS tokens. Semantic tokens have two modes: launch (default, navy) and paper (reports, print). Values mirror the Figma variables in file pzP3hBWEaChKMvRP6wc57s.",
  "primitive": {
    "navy": { "50": "#EEF0F9", "100": "#DADEF1", "200": "#B5BDE3", "300": "#8E99D2", "400": "#6474C4", "500": "#4A5CBE", "600": "#3A4479", "700": "#212C67", "800": "#1A2458", "900": "#111A36" },
    "lime": { "50": "#FAFBEA", "100": "#F4F6D3", "200": "#EBEEBD", "300": "#E2E898", "400": "#D8E072", "500": "#C2CB4E", "600": "#A3AC35", "700": "#7C8327", "800": "#575C1D", "900": "#363A14" },
    "neutral": { "0": "#FFFFFF", "50": "#F3F5FA", "100": "#E4E7F0", "200": "#D0D4E2", "300": "#BCC1D6", "400": "#A5AAB8", "500": "#7F8598", "600": "#5E6478", "700": "#434859", "800": "#2A2E3B", "900": "#15171F", "1000": "#07080D" },
    "violet": { "500": "#3B3859" },
    "glow": { "blue": "rgba(74, 92, 190, 0.45)", "lime": "rgba(216, 224, 114, 0.10)" },
    "poster-sampled": ["navy.600", "navy.700", "navy.800", "navy.900", "lime.200", "lime.400", "neutral.50", "neutral.300", "neutral.400", "neutral.1000", "violet.500"]
  },
  "semantic": {
    "bg/page":             { "launch": "{navy.700}",    "paper": "{neutral.0}" },
    "bg/surface":          { "launch": "{navy.800}",    "paper": "{neutral.50}" },
    "bg/deep":             { "launch": "{navy.900}",    "paper": "{neutral.100}" },
    "bg/ink":              { "launch": "{neutral.1000}", "paper": "{neutral.1000}" },
    "bg/accent":           { "launch": "{lime.400}",    "paper": "{lime.400}" },
    "bg/accent-pressed":   { "launch": "{lime.500}",    "paper": "{lime.500}" },
    "bg/accent-soft":      { "launch": "{navy.600}",    "paper": "{lime.100}" },
    "bg/disabled":         { "launch": "{navy.600}",    "paper": "{neutral.100}" },
    "text/primary":        { "launch": "{neutral.50}",  "paper": "{navy.900}" },
    "text/secondary":      { "launch": "{neutral.300}", "paper": "{neutral.600}" },
    "text/accent":         { "launch": "{lime.400}",    "paper": "{navy.700}" },
    "text/on-accent":      { "launch": "{neutral.1000}", "paper": "{neutral.1000}" },
    "text/on-ink":         { "launch": "{neutral.50}",  "paper": "{neutral.50}" },
    "text/on-ink-accent":  { "launch": "{lime.400}",    "paper": "{lime.400}" },
    "text/disabled":       { "launch": "{neutral.500}", "paper": "{neutral.400}" },
    "border/default":      { "launch": "{neutral.400}", "paper": "{neutral.400}" },
    "border/rule":         { "launch": "{navy.600}",    "paper": "{neutral.200}" },
    "border/strong":       { "launch": "{neutral.50}",  "paper": "{navy.900}" },
    "border/focus":        { "launch": "{lime.400}",    "paper": "{navy.700}" },
    "icon/primary":        { "launch": "{neutral.50}",  "paper": "{navy.900}" },
    "icon/secondary":      { "launch": "{neutral.300}", "paper": "{neutral.600}" },
    "icon/accent":         { "launch": "{lime.400}",    "paper": "{navy.700}" },
    "icon/on-accent":      { "launch": "{neutral.1000}", "paper": "{neutral.1000}" },
    "icon/disabled":       { "launch": "{neutral.500}", "paper": "{neutral.400}" },
    "deco/pixel":          { "launch": "{lime.400}",    "paper": "{lime.400}" },
    "deco/pixel-shadow":   { "launch": "{violet.500}",  "paper": "{navy.200}" },
    "deco/doodle":         { "launch": "{neutral.50}",  "paper": "{navy.700}" },
    "deco/glow-blue":      { "launch": "{glow.blue}",   "paper": "{navy.50}" },
    "deco/glow-lime":      { "launch": "{glow.lime}",   "paper": "{lime.50}" }
  },
  "layout": {
    "space": { "4": 4, "8": 8, "12": 12, "16": 16, "24": 24, "32": 32, "48": 48, "64": 64 },
    "radius": { "sm": 8, "md": 12, "lg": 20, "full": 999 },
    "stroke": { "default": 1.5, "strong": 2 },
    "container": 1120,
    "breakpoint-mobile": 680
  },
  "typography": {
    "font": {
      "display": "Black Han Sans",
      "brush": "Permanent Marker",
      "body": "Pretendard (web) / Noto Sans KR (Figma fallback)"
    },
    "Display/Band":     { "font": "display", "size": 64,  "lineHeight": 1.1, "tracking": "-1%" },
    "Display/Band-md":  { "font": "display", "size": 40,  "lineHeight": 1.1, "tracking": "-1%" },
    "Display/Brush":    { "font": "brush",   "size": 120, "lineHeight": 0.9 },
    "Display/Brush-md": { "font": "brush",   "size": 72,  "lineHeight": 0.9 },
    "Display/Tape":     { "font": "display", "size": 32,  "lineHeight": 1.2, "tracking": "-1%" },
    "Display/Tag":      { "font": "display", "size": 32,  "lineHeight": 1.0 },
    "Display/Step":     { "font": "display", "size": 20,  "lineHeight": 1.2 },
    "Number/Date":      { "font": "body", "weight": 700, "size": 56, "lineHeight": 1.0, "tracking": "-2%" },
    "Number/Day":       { "font": "body", "weight": 700, "size": 40, "lineHeight": 1.1 },
    "Number/Time":      { "font": "body", "weight": 400, "size": 32, "lineHeight": 1.2 },
    "Heading/H1":       { "font": "body", "weight": 700, "size": 32, "lineHeight": 1.4, "tracking": "-2%" },
    "Heading/H2":       { "font": "body", "weight": 700, "size": 24, "lineHeight": 1.4, "tracking": "-1%" },
    "Heading/H3":       { "font": "body", "weight": 700, "size": 20, "lineHeight": 1.4, "tracking": "-1%" },
    "Body/Body-lg":     { "font": "body", "weight": 400, "size": 18, "lineHeight": 1.6 },
    "Body/Body":        { "font": "body", "weight": 400, "size": 16, "lineHeight": 1.6 },
    "Body/Body-sm":     { "font": "body", "weight": 400, "size": 14, "lineHeight": 1.6 },
    "Body/Caption":     { "font": "body", "weight": 400, "size": 12, "lineHeight": 1.6 },
    "Body/Label":       { "font": "body", "weight": 500, "size": 14, "lineHeight": 1.4 },
    "Body/Button-lg":   { "font": "body", "weight": 700, "size": 18, "lineHeight": 1.2 },
    "Body/Button":      { "font": "body", "weight": 700, "size": 16, "lineHeight": 1.2 },
    "Body/Button-sm":   { "font": "body", "weight": 700, "size": 14, "lineHeight": 1.2 }
  }
}
